{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Batik",
  "scopeName": "text.batik",
  "patterns": [
    { "include": "#komentar" },
    { "include": "#seksi" },
    { "include": "#variabel" },
    { "include": "text.html.basic" }
  ],
  "repository": {
    "komentar": {
      "begin": "\\{\\{!",
      "end": "\\}\\}",
      "name": "comment.block.batik"
    },
    "seksi": {
      "match": "(\\{\\{)(#|/)(jika|kecuali)\\s+([a-zA-Z_][a-zA-Z0-9_]*)?(\\}\\})",
      "captures": {
        "1": { "name": "punctuation.definition.tag.batik" },
        "2": { "name": "keyword.control.batik" },
        "3": { "name": "keyword.control.batik" },
        "4": { "name": "variable.other.batik" },
        "5": { "name": "punctuation.definition.tag.batik" }
      }
    },
    "variabel": {
      "match": "(\\{\\{)([a-zA-Z_][a-zA-Z0-9_]*)(\\}\\})",
      "captures": {
        "1": { "name": "punctuation.definition.tag.batik" },
        "2": { "name": "variable.other.batik" },
        "3": { "name": "punctuation.definition.tag.batik" }
      }
    }
  }
}
